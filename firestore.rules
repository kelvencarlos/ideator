rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }
    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }
    function requestPath(projectId, userId) {
      return /databases/$(database)/documents/projects/$(projectId)/requests/$(userId);
    }
    function acceptedInProject(userId, projectId) {
      let projectAfter = getAfter(projectPath(projectId)).data;
      return request.auth != null
        && projectAfter.ownerId == request.auth.uid
        && projectAfter.memberIds.hasAny([userId])
        && projectAfter.memberIds.size() <= projectAfter.maxMembers
        && getAfter(requestPath(projectId, userId)).data.status == 'accepted';
    }
    function hasProjectSpace(projectId, userId) {
      let projectData = get(projectPath(projectId)).data;
      let memberIds = projectData.get('memberIds', [projectData.ownerId]);
      return memberIds.hasAny([userId]) == false
        && projectData.get('members', 1) < projectData.get('maxMembers', 5);
    }
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.maxMembers is int
        && request.resource.data.maxMembers >= 1
        && request.resource.data.maxMembers <= 50
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members == 1;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.maxMembers >= request.resource.data.members
        && request.resource.data.maxMembers <= 50;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /requests/{userId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || get(projectPath(projectId)).data.ownerId == request.auth.uid);
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.availability is list
          && hasProjectSpace(projectId, userId)
          && (!exists(userPath(userId)) || get(userPath(userId)).data.get('activeProjectId', '') == '');
        allow update: if request.auth != null && (
          (request.auth.uid == userId
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'name', 'photoURL', 'availability', 'status', 'createdAt']))
          || (get(projectPath(projectId)).data.ownerId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (request.resource.data.status == 'rejected'
              || (request.resource.data.status == 'accepted'
                && getAfter(projectPath(projectId)).data.memberIds.hasAny([userId])
                && getAfter(projectPath(projectId)).data.memberIds.size() <= getAfter(projectPath(projectId)).data.maxMembers)))
          || (resource.data.status in ['pending', 'rejected']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && existsAfter(userPath(userId))
            && acceptedInProject(userId, getAfter(userPath(userId)).data.activeProjectId))
        );
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'createdAt', 'updatedAt', 'pendingProjectIds']);
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'createdAt', 'updatedAt', 'pendingProjectIds']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeProjectId', 'pendingProjectIds'])
          && request.resource.data.activeProjectId is string
          && acceptedInProject(userId, request.resource.data.activeProjectId))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
